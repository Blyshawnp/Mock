<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WorkflowCardBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="DashboardCardStyle" TargetType="Border" BasedOn="{StaticResource WorkflowCardBorderStyle}">
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="ModalCardStyle" TargetType="Border" BasedOn="{StaticResource WorkflowCardBorderStyle}">
        <Setter Property="Width" Value="760" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="#FF1D2642" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
</ResourceDictionary>
