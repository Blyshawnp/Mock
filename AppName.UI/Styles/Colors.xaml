<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Background">#FFF5F7FA</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceMuted">#FFF9FBFD</Color>
    <Color x:Key="Color.Border">#FFD4DCE5</Color>
    <Color x:Key="Color.TextPrimary">#FF1F2A37</Color>
    <Color x:Key="Color.TextSecondary">#FF5C6B7A</Color>

    <Color x:Key="Color.Accent">#FF2F6FED</Color>
    <Color x:Key="Color.AccentHover">#FF245ACC</Color>

    <Color x:Key="Color.WarningBackground">#FFFFF4E5</Color>
    <Color x:Key="Color.WarningBorder">#FFF0B64C</Color>

    <Color x:Key="Color.PassBackground">#FFE8F7ED</Color>
    <Color x:Key="Color.PassBorder">#FF5AA772</Color>
    <Color x:Key="Color.FailBackground">#FFFDEAEA</Color>
    <Color x:Key="Color.FailBorder">#FFD96A6A</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="{StaticResource Color.SurfaceMuted}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="{StaticResource Color.WarningBackground}" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="{StaticResource Color.WarningBorder}" />
    <SolidColorBrush x:Key="Brush.PassBackground" Color="{StaticResource Color.PassBackground}" />
    <SolidColorBrush x:Key="Brush.PassBorder" Color="{StaticResource Color.PassBorder}" />
    <SolidColorBrush x:Key="Brush.FailBackground" Color="{StaticResource Color.FailBackground}" />
    <SolidColorBrush x:Key="Brush.FailBorder" Color="{StaticResource Color.FailBorder}" />
</ResourceDictionary>
