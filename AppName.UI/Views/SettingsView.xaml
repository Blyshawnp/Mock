<UserControl x:Class="AppName.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AppName.UI.Controls"
             xmlns:converters="clr-namespace:AppName.UI.Converters"
             xmlns:enums="clr-namespace:AppName.Core.Models.Enums;assembly=AppName.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1200"
             Loaded="SettingsView_OnLoaded">
    <UserControl.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <ObjectDataProvider x:Key="DonorScenarioValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:DonorScenario" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleTextBlockStyle}"
                   Text="Settings" />

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,8"
                   Foreground="DarkSlateGray"
                   Text="Editable operational lookup data only. Help, Tutorial, and Discord/system messages are excluded." />

        <Border Grid.Row="2"
                Margin="0,0,0,8"
                Padding="8"
                Background="#FFFDECEA"
                BorderBrush="#FFE57373"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding ValidationErrors}" />
        </Border>

        <ScrollViewer Grid.Row="3">
            <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                <controls:LookupTableEditorControl Title="Call Types"
                                                   ItemsSource="{Binding CallTypes}" />

                <controls:LookupTableEditorControl Margin="0,12,0,0"
                                                   Title="Supervisor Reasons"
                                                   ItemsSource="{Binding SupervisorReasons}" />

                <controls:LookupTableEditorControl Margin="0,12,0,0"
                                                   Title="Fail Reasons"
                                                   ItemsSource="{Binding FailReasons}" />

                <controls:LookupTableEditorControl Margin="0,12,0,0"
                                                   Title="Coaching Categories"
                                                   ItemsSource="{Binding CoachingCategories}" />

                <GroupBox Margin="0,12,0,0" Header="Show Offers (rich model editor)">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Add Show" Command="{Binding AddShowOfferCommand}" Margin="0,0,8,0" />
                            <Button Content="Remove Show" Command="{Binding RemoveShowOfferCommand}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  ItemsSource="{Binding ShowOffers}"
                                  SelectedItem="{Binding SelectedShowOffer, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Show Name" Binding="{Binding ShowName, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTextColumn Header="One-Time" Binding="{Binding OneTimeAmount, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Monthly" Binding="{Binding MonthlyAmount, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Gift" Binding="{Binding GiftDescription, UpdateSourceTrigger=PropertyChanged}" Width="3*" />
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Sort" Binding="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>

                <GroupBox Margin="0,12,0,0" Header="Donor Profiles (rich model editor)">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Add Donor" Command="{Binding AddDonorProfileCommand}" Margin="0,0,8,0" />
                            <Button Content="Remove Donor" Command="{Binding RemoveDonorProfileCommand}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  ItemsSource="{Binding DonorProfiles}"
                                  SelectedItem="{Binding SelectedDonorProfile, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Scenario"
                                                        Width="*"
                                                        SelectedItemBinding="{Binding DonorScenario, UpdateSourceTrigger=PropertyChanged}"
                                                        ItemsSource="{Binding Source={StaticResource DonorScenarioValues}}" />
                                <DataGridTextColumn Header="First" Binding="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Last" Binding="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Address" Binding="{Binding AddressLine, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTextColumn Header="City" Binding="{Binding City, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="State" Binding="{Binding State, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Zip" Binding="{Binding ZipCode, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Email" Binding="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Sort" Binding="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="DarkSlateGray" Text="{Binding StatusMessage}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                           Text="Working..." />
                <Button Content="Reload" Command="{Binding LoadCommand}" Margin="0,0,8,0" />
                <Button Content="Save" Command="{Binding SaveCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
