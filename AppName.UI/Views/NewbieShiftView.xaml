<UserControl x:Class="AppName.UI.Views.NewbieShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:AppName.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:NullableBoolEqualsConverter x:Key="NullableBoolEqualsConverter" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleTextBlockStyle}"
                   Text="Newbie Shift Quick Reference" />

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8">
            <TextBlock Text="Final Attempt"
                       Foreground="Red"
                       FontWeight="Bold"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center" />
            <RadioButton Content="Yes"
                         GroupName="FinalAttempt"
                         IsChecked="{Binding IsFinalAttempt, Mode=TwoWay, Converter={StaticResource NullableBoolEqualsConverter}, ConverterParameter=True}"
                         Margin="0,0,10,0" />
            <RadioButton Content="No"
                         GroupName="FinalAttempt"
                         IsChecked="{Binding IsFinalAttempt, Mode=TwoWay, Converter={StaticResource NullableBoolEqualsConverter}, ConverterParameter=False}" />
        </StackPanel>


        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Workflow Guidance" Margin="0,0,12,0">
                <ListBox ItemsSource="{Binding QuickReferences}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock FontWeight="Bold" Text="{Binding Title}" />
                                <TextBlock Foreground="DarkSlateGray" Text="{Binding Source}" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Guidance}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Reminders" Margin="0,0,12,0">
                <ItemsControl ItemsSource="{Binding Reminders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding StringFormat=• {0}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Common Mistakes">
                <ItemsControl ItemsSource="{Binding CommonMistakes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Foreground="DarkRed" Text="{Binding StringFormat=• {0}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="2" Foreground="DarkSlateGray" Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
