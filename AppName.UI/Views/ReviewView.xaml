<UserControl x:Class="AppName.UI.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AppName.UI.Controls"
             xmlns:converters="clr-namespace:AppName.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleTextBlockStyle}"
                   Text="Review" />

        <controls:WarningBannerControl Grid.Row="1"
                                       Margin="0,12,0,12"
                                       BannerVisibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibilityConverter}}"
                                       ItemsSource="{Binding Warnings}" />

        <GroupBox Grid.Row="2"
                  Margin="0,0,0,12"
                  Header="Session Summary">
            <TextBox IsReadOnly="True"
                     MinHeight="120"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     Text="{Binding SessionSummary}" />
        </GroupBox>

        <StackPanel Grid.Row="3"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
            <controls:SummaryPanelControl Title="Coaching Summary"
                                          SummaryText="{Binding CoachingSummary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          RegenerateCommand="{Binding RegenerateCoachingSummaryCommand}"
                                          RetryCommand="{Binding RetrySummariesCommand}" />

            <controls:SummaryPanelControl Margin="0,12,0,0"
                                          Title="Fail Summary"
                                          SummaryText="{Binding FailSummary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          RegenerateCommand="{Binding RegenerateFailSummaryCommand}"
                                          RetryCommand="{Binding RetrySummariesCommand}" />

            <TextBlock Margin="0,8,0,0"
                       Foreground="DarkSlateBlue"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                       Text="Generating summaries..." />

            <TextBlock Margin="0,8,0,0"
                       Foreground="DarkSlateGray"
                       Text="{Binding SummaryStatusMessage}" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    Orientation="Horizontal">
            <Button Content="Submit Review"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Command="{Binding OpenSubmitReviewPopupCommand}" />

            <TextBlock Margin="12,6,0,0"
                       Foreground="DarkGreen"
                       Visibility="{Binding SubmitConfirmed, Converter={StaticResource BoolToVisibilityConverter}}"
                       Text="Review submitted." />
        </StackPanel>

        <Grid Background="#96060B14"
              Visibility="{Binding ShowSubmitReviewDialog, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="500"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}"
                               HorizontalAlignment="Center"
                               Text="Review and Submit" />
                    <TextBlock Margin="0,12,0,18"
                               TextWrapping="Wrap"
                               Text="You are about to submit this review. Continue?" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Cancel"
                                Command="{Binding CancelSubmitReviewPopupCommand}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Submit"
                                Margin="10,0,0,0"
                                Command="{Binding SubmitReviewCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
