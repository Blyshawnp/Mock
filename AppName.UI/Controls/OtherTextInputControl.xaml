<UserControl x:Class="AppName.UI.Controls.OtherTextInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="90"
             d:DesignWidth="450">
    <StackPanel>
        <TextBlock FontWeight="SemiBold"
                   Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <TextBox Margin="0,6,0,0"
                 MinWidth="280"
                 Text="{Binding TextValue, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <TextBlock Margin="0,4,0,0"
                   Foreground="Firebrick"
                   Text="Required when 'Other' is selected."
                   Visibility="{Binding IsRequiredMessageVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </StackPanel>
</UserControl>
